# Copy this file to ".env" while you develop.

# Local database file (prisma/dev.sqlite).
DATABASE_URL="file:dev.sqlite"

# Plan check. While you run `npm run dev`, Corkcount skips it and treats every
# store as Pro, so you can test before your pricing plans exist. On a
# production server it always checks. Uncomment one line to override:
# CORKCOUNT_BILLING_BYPASS=false   # test the real plan check during dev
# CORKCOUNT_BILLING_BYPASS=true    # never set this on a production server

# Print every Shopify sign-in step in the terminal (very noisy). Use when the
# app shows "Handling response" or a blank page and you need to see why.
# CORKCOUNT_DEBUG=true
