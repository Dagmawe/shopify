# Copy this file to ".env" while you develop.

# Skips the plan check so you can use the app before your pricing plans exist
# in the Partner Dashboard. Remove it (or set to false) before you launch.
CASEFLOW_BILLING_BYPASS=true

# Your app's handle, shown in its Partner Dashboard URL. Used to send
# merchants to Shopify's plan-selection page.
SHOPIFY_APP_HANDLE=caseflow
